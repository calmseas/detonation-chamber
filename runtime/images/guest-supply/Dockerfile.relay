# The confound-free supply-chain cell: chamber-guest-supply's baked-payload
# lineage merged with chamber-guest-exec-relay's interception lineage, so one
# cell can run an h-mal-* rung's payload AND the exec-consequence relay that
# makes chamber-ca.pem's exec-visible surface confound-free (hide-entry, the
# ls/find filter — see hide-entry.c).
#
# MUST be built for linux/arm64 — build-rungs.sh's --relay path passes
# `--platform linux/arm64` explicitly. execrelayd's interception mechanism (a
# seccomp filter gated on AUDIT_ARCH_AARCH64 plus arm64 register plumbing) is
# aarch64-only by decision; see design artefact
# agenticpractices:artefact:2rau75fl5jsg3c4c8pla section 7. relayd.c carries a
# matching `#error` so a wrong-arch build fails HERE, not at runtime.
#
# An ADDITIONAL opt-in image per rung (chamber-guest-supply-<rung>-relay:test),
# never a replacement for chamber-guest-supply-<rung>:test — see
# CHAMBER_CONFOUND_FREE in chamber-run/src/run.rs for the harness-side knob
# that selects it.
FROM alpine:3.20 AS builder
RUN apk add --no-cache gcc musl-dev linux-headers
RUN mkdir -p /out
WORKDIR /src
COPY relay-src/json.h relay-src/json.c relay-src/base64.h relay-src/base64.c relay-src/config.h relay-src/config.c relay-src/protocol.h relay-src/protocol.c relay-src/record.h relay-src/record.c relay-src/rewrite.h relay-src/rewrite.c relay-src/scratch.h relay-src/scratch.c relay-src/relayd.c relay-src/stub.c relay-src/fabricate-emit.c relay-src/hide-entry.c ./
RUN gcc -O2 -Wall -Wextra -std=c11 -o /out/execrelayd relayd.c config.c json.c base64.c record.c protocol.c rewrite.c scratch.c \
 && gcc -O2 -Wall -Wextra -std=c11 -o /out/stub stub.c \
 && gcc -O2 -Wall -Wextra -std=c11 -o /out/fabricate-emit fabricate-emit.c base64.c \
 && gcc -O2 -Wall -Wextra -std=c11 -o /out/hide-entry hide-entry.c

FROM alpine:3.20
RUN apk add --no-cache curl ca-certificates bind-tools python3
COPY --from=builder /out/execrelayd /usr/local/bin/execrelayd
COPY --from=builder /out/stub /usr/local/bin/stub
COPY --from=builder /out/fabricate-emit /usr/local/bin/fabricate-emit
COPY --from=builder /out/hide-entry /usr/local/bin/hide-entry

# The rung's package behaviour: payload.sh (install-time) and module.py
# (use-time), baked in rather than staged into /work — see guest-supply's own
# Dockerfile for the full rationale (unchanged here, just merged).
COPY rung/ /opt/pkg/
COPY pip-shim.sh /usr/local/bin/pip
RUN cp /usr/local/bin/pip /usr/local/bin/pip3 && chmod +x /usr/local/bin/pip /usr/local/bin/pip3
ENV PYTHONPATH=/work

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/execrelayd"]
